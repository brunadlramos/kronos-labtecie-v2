{
  "name": "kronos-rules-tests",
  "private": true,
  "type": "module",
  "description": "Portao de testes das Security Rules do Realtime Database (onda 1).",
  "scripts": {
    "emu": "firebase emulators:start --only database --project kronos-rules-test",
    "test": "node --test rules.test.js",
    "test:ci": "firebase emulators:exec --only database --project kronos-rules-test \"node --test rules.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^10.12.0",
    "firebase-tools": "^13.29.1"
  }
}
