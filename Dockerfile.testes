# Container so para testar as Security Rules (JDK 21 + Node). Nada roda no host.
FROM node:22-bookworm-slim
COPY --from=eclipse-temurin:21-jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk PATH=/opt/java/openjdk/bin:$PATH
RUN mkdir -p /work/tests/node_modules /home/node/.cache && chown -R node:node /work /home/node
USER node
WORKDIR /work/tests
